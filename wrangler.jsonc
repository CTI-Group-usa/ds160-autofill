{
  // Config for the ds160-auth Cloudflare Worker — the Microsoft 365 sign-in
  // gate for the DS-160 worksheet. It holds no applicant data; see worker.js.
  //
  // ⚠️ keep_vars IS LOAD-BEARING, AND IT IS HERE BEFORE THE FIRST DEPLOY ON
  // PURPOSE. Without it, `wrangler deploy` DELETES every var and secret set in
  // the dashboard that is not declared in this file — and none of this
  // Worker's secrets are declared here, because they must not be committed.
  // A single deploy without the flag would wipe SSO_TENANT_ID, SSO_CLIENT_ID
  // and SSO_CLIENT_SECRET and lock everyone out of the worksheet.
  //
  // This is not hypothetical. On 2026-08-12 exactly this destroyed the CTI
  // Indonesia Monitoring dashboard: its CI had never once succeeded, so every
  // change had been hand-pasted in the dashboard (which leaves secrets alone).
  // The moment CI was repaired, the first real deploy silently emptied the
  // Zoho credentials, and the upstream error read "You have made too many
  // requests continuously" — indistinguishable from a rate limit, and hours
  // were lost chasing a throttle that did not exist.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ds160-auth",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "keep_vars": true,
  "workers_dev": true,

  // The "putu-astra" account (Putu.astra@cti-usa.com) - the same one that runs
  // cti-indo-proxy. NOT name-neutral: see the note in CLAUDE.md. Chosen by the
  // user on 2026-09-02 to get the gate working without another login dance.
  // Non-secret. If this Worker should live on a different CTI account, change
  // this AND the WORKER_ORIGIN constant at the top of worker.js and the WORKER
  // constant in auth.js — Microsoft compares the redirect URI exactly.
  "account_id": "e9e538d5b8134729e6cd90a7cb8da53b",

  "kv_namespaces": [
    // Holds one-time OAuth `state` values and the issued session tokens.
    // Nothing else, and every entry carries a TTL.
    //
    // The "ds160-auth-sessions" namespace, created 2026-09-02. Bound as
    // TOKEN_CACHE rather than the name wrangler suggested - worker.js reads
    // env.TOKEN_CACHE, and the binding name is ours to choose.
    { "binding": "TOKEN_CACHE", "id": "ebec7827472647a2b602b4d0f0181483" }
  ],

  "observability": { "enabled": true }
}
