node_modules/
.DS_Store

# THIS REPOSITORY IS PUBLIC. A real intake export dropped in this folder must
# never be committed - it holds seafarer passport numbers, dates of birth,
# addresses and parents' names. `git add -A` would otherwise take it, and
# `git rm` afterwards does not unpublish it.
*.csv
*.tsv
*.xlsx
*.xls
*.pdf

# ...except the generated test fixture, which contains invented rows only
# (test/make-fixture.py builds it).
!test/fixtures/sample.xlsx
.claude/

# DS-2019 / DS-7002 samples are third-party documents and this repo is
# public. test/ds2019.test.js runs against one only if it is present locally.
*.docx
