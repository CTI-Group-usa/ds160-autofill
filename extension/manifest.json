{
  "manifest_version": 3,
  "name": "CTI DS-160 Autofill",
  "version": "0.2.0",
  "description": "Fills the DS-160 form on ceac.state.gov from a CTI seafarer intake record, and fetches the supporting letter the worksheet page cannot reach. The agent still reviews, solves the security check, and signs.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://ceac.state.gov/*",
    "https://*.zoho.com/*",
    "https://*.zohoexternal.com/*",
    "https://*.zohousercontent.com/*"
  ],
  "action": {
    "default_title": "CTI DS-160 Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ceac.state.gov/*"
      ],
      "js": [
        "matcher.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cti-group-usa.github.io/ds160-autofill/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
